div #root w-full h-full flex flex-col bg-zinc-950 text-zinc-100 overflow-hidden
  div #topbar h-11 w-full flex flex-row items-center px-4 border-b border-zinc-800 gap-3 shrink-0
    div flex flex-row items-center gap-2
      button w-2.5 h-2.5 rounded-full bg-red-500 hover:bg-red-400 @click=close_window
      button w-2.5 h-2.5 rounded-full bg-amber-500 hover:bg-amber-400 @click=minimize_window
      button w-2.5 h-2.5 rounded-full bg-emerald-500 hover:bg-emerald-400 @click=maximize_window
    span text-sm font-semibold text-zinc-300
      "telekinesis"
    div flex-1
    div flex flex-row items-center gap-2 px-2 py-1 rounded-full bg-zinc-900 border border-zinc-800
      div w-1.5 h-1.5 rounded-full
        if {connected}
          if {busy}
            bg-amber-400
          else
            bg-emerald-400
        else
          bg-red-400
      span text-xs text-zinc-400 font-mono
        "{status}"
      span text-xs text-zinc-600
        "·"
      span text-xs text-zinc-500 font-mono
        "{provider}"
    if {connected}
      div flex flex-row items-center gap-1
        if {computer_active}
          button text-xs font-mono px-2 py-0.5 rounded-full text-indigo-300 @click=use_computer
            "computer"
        else
          button text-xs font-mono px-2 py-0.5 rounded-full text-zinc-500 @click=use_computer
            "computer"
        if {coding_active}
          button text-xs font-mono px-2 py-0.5 rounded-full text-indigo-300 @click=use_coding
            "code"
        else
          button text-xs font-mono px-2 py-0.5 rounded-full text-zinc-500 @click=use_coding
            "code"
    span text-xs text-zinc-600 font-mono
      "{model} · {context_pct}% context"
  div #messages flex-1 w-full overflow-y-scroll
    div w-full max-w-240 mx-auto px-5 py-5 flex flex-col gap-3
      for message in {messages}
        div w-full flex flex-col
          if {message.is_tool}
            div w-full flex flex-row items-start gap-2 py-1 font-mono
              span text-xs text-zinc-700
                "│"
              span text-xs text-cyan-400
                "{message.role}"
              span flex-1 text-xs text-zinc-500
                "{message.content}"
          else
            if {message.is_user}
              div w-full flex flex-row justify-end
                div max-w-80 px-3 py-2 rounded-2xl bg-indigo-600
                  span text-sm text-white
                    "{message.content}"
            else
              if {message.is_error}
                div w-full flex flex-row items-start gap-2 py-1
                  span text-xs text-red-500 font-mono
                    "!"
                  span flex-1 text-sm text-red-300
                    "{message.content}"
              else
                div w-full flex flex-row items-start gap-2
                  div w-6 h-6 rounded-full bg-zinc-800 flex items-center justify-center shrink-0 mt-1
                    span text-xs text-zinc-400
                      "ai"
                  div flex-1
                    div max-w-80 px-3 py-2 rounded-2xl bg-zinc-900 border border-zinc-800
                      span text-sm text-zinc-100
                        "{message.content}"
  div #composer w-full shrink-0 flex flex-col items-center px-4 pb-4 pt-2
    div w-full max-w-240 min-h-14 rounded-2xl bg-zinc-900 border border-zinc-700 flex flex-col
      div min-h-8 w-full px-3 pt-2 text-sm text-zinc-100 font-mono
        "{input}"
      div h-6 w-full flex flex-row items-center px-3
        span text-xs text-zinc-500 font-mono
          if {connected}
            "enter to send · /login · /clear · ctrl+alt+space"
          else
            "run `tk login openai` or /login"
        span flex-1
        if {busy}
          button text-zinc-400 hover:text-zinc-100 text-xs font-mono @click=interrupt
            "stop"
        else
          if {connected}
            button text-emerald-400 hover:text-emerald-300 text-xs font-mono @click=send_prompt
              "send ↵"
          else
            if {login_busy}
              span text-xs text-amber-400 font-mono
                "logging in"
            else
              button text-emerald-400 hover:text-emerald-300 text-xs font-mono @click=start_login
                "login"
