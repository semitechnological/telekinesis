div #root w-full h-full flex flex-col bg-zinc-950 text-zinc-100 overflow-hidden
  div #topbar h-10 w-full flex flex-row items-center px-3 border-b border-zinc-800
    div flex flex-row items-center gap-2
      button w-2.5 h-2.5 rounded-full bg-red-500 hover:bg-red-400 @click=close_window
      button w-2.5 h-2.5 rounded-full bg-amber-500 hover:bg-amber-400 @click=minimize_window
      button w-2.5 h-2.5 rounded-full bg-emerald-500 hover:bg-emerald-400 @click=maximize_window
    span text-xs text-zinc-500 font-mono ml-4
      "telekinesis"
    span text-xs text-zinc-700 font-mono ml-2
      "{model}"
    span flex-1
    span text-xs text-zinc-600 font-mono mr-3
      "{context_pct}% context"
    div w-1.5 h-1.5 rounded-full
      if {connected}
        if {busy}
          bg-amber-400
        else
          bg-emerald-400
      else
        bg-red-400
    span text-xs text-zinc-500 font-mono ml-2
      "{status}"
  div #messages flex-1 w-full overflow-y-scroll
    div w-full max-w-240 mx-auto px-5 py-5 flex flex-col gap-2
      for message in {messages}
        div w-full flex flex-col
          if {message.is_tool}
            div w-full flex flex-row items-start gap-2 py-1 font-mono
              span text-xs text-zinc-700
                "│"
              span text-xs text-cyan-400
                "{message.role}"
              span flex-1 text-xs text-zinc-500 truncate
                "{message.content}"
          else
            if {message.is_user}
              div w-full flex flex-row items-start gap-3 py-2 border-t border-zinc-900
                span text-sm text-emerald-400 font-mono
                  "›"
                span flex-1 text-sm text-zinc-100
                  "{message.content}"
            else
              if {message.is_error}
                div w-full flex flex-row items-start gap-2 py-1 font-mono
                  span text-xs text-red-500
                    "!"
                  span flex-1 text-xs text-red-300
                    "{message.content}"
              else
                div w-full flex flex-row items-start gap-2 py-1
                  span text-xs text-zinc-700 font-mono
                    "│"
                  span flex-1 text-sm text-zinc-300
                    "{message.content}"
  div #composer w-full shrink-0 flex flex-col items-center px-4 pb-4
    div w-full max-w-240 min-h-14 rounded-lg bg-zinc-900 border border-zinc-700 flex flex-col
      div min-h-8 w-full px-3 pt-2 text-sm text-zinc-100 font-mono
        "{input}"
      div h-6 w-full flex flex-row items-center px-3
        span text-xs text-zinc-600 font-mono
          if {connected}
            "enter to send"
          else
            "tk login grok"
        span flex-1
        if {busy}
          button text-zinc-400 hover:text-zinc-100 text-xs font-mono @click=interrupt
            "stop"
        else
          if {connected}
            button text-emerald-400 hover:text-emerald-300 text-xs font-mono @click=send_prompt
              "send ↵"
